# Chave do Google AI Studio (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=

# Mantem o ADK usando a API do Google AI Studio (nao o Vertex AI).
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Modelo Gemini usado por todos os agentes. Opcional: se nao definido, usa
# gemini-flash-lite-latest. Preferimos um alias "-latest" 
GOOGLE_MODEL=gemini-flash-lite-latest
